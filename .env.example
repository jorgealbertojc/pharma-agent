# ============================================================
# Redis Local
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_TTL=3600  # Tiempo de vida en segundos (comentado = sin expiración)

# ============================================================
# Google Cloud Platform / Google Sheets
# ============================================================

GOOGLE_APPLICATION_CREDENTIALS=/etc/pharma-agent/secrets/gcp-credentials.json
SPREADSHEET_ID=1YdwowSe3lofJOV7mx1M6grMJEmWTAJ0kW1GfS239NBM

# ============================================================
# DynamoDB (local con Floci)
# ============================================================
# Nombre de la tabla para el historial de conversaciones
DYNAMODB_CHAT_HISTORY_TABLE=pharma_chat_history

# Nombre de la tabla para la caché del inventario
DYNAMODB_INVENTORY_CACHE_TABLE=pharma_inventory_cache

# Endpoint de DynamoDB (para Floci o AWS real)
DYNAMODB_ENDPOINT_URL=http://localhost:4566

# Región de AWS (us-east-1 para Floci)
DYNAMODB_REGION=us-east-1

# Credenciales para Floci (test/test). Para AWS real, usar credenciales reales.
DYNAMODB_ACCESS_KEY_ID=test
DYNAMODB_SECRET_ACCESS_KEY=test
