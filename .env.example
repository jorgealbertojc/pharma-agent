# ============================================================
# Application configuration
# ============================================================
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=DEBUG
AGENT_NAME=favisa-pharmacy-helper

# Temperature for LLM generation (applies to any provider, currently Bedrock)
IA_MODEL_TEMPERATURE=0

# ============================================================
# DynamoDB (chat history and inventory cache)
# ============================================================
# Required table for chat history
DYNAMODB_CHAT_HISTORY_TABLE=pharma_chat_history

# Required table for inventory cache
DYNAMODB_INVENTORY_CACHE_TABLE=pharma_inventory_cache

# Endpoint (Floci local by default, change for AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:4566

# AWS region
DYNAMODB_REGION=us-east-1

# Credentials (test/test for Floci; replace with real credentials for AWS)
DYNAMODB_ACCESS_KEY_ID=test
DYNAMODB_SECRET_ACCESS_KEY=test

# ============================================================
# OpenSearch (vector store for RAG)
# ============================================================
# Host and port (Floci exposes real OpenSearch on port 9400)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9400

# Required index name
OPENSEARCH_INDEX_NAME=pharma_vector_index

# Required vector dimensions (must match embedding model)
OPENSEARCH_INDEX_DIMENSIONS=768

# Similarity metric (cosine, euclidean, dotproduct)
OPENSEARCH_INDEX_METRIC=cosine

# Credentials (test/test for Floci; replace for AWS)
OPENSEARCH_ACCESS_KEY_ID=test
OPENSEARCH_SECRET_ACCESS_KEY=test
OPENSEARCH_REGION=us-east-1

# ============================================================
# Bedrock (LLM and embeddings)
# ============================================================
# Required AWS region
BEDROCK_REGION=us-east-1

# Required model IDs
BEDROCK_EMBEDDINGS_MODEL=amazon.titan-embed-text-v1
BEDROCK_LLM_MODEL=anthropic.claude-3-haiku-20240307-v1:0

# Endpoint (Floci local by default, change for AWS)
BEDROCK_ENDPOINT_URL=http://localhost:4566

# Credentials (test/test for Floci; replace with real credentials for AWS)
BEDROCK_ACCESS_KEY_ID=test
BEDROCK_SECRET_ACCESS_KEY=test

# ============================================================
# Google Sheets (inventory source)
# ============================================================
GOOGLE_APPLICATION_CREDENTIALS=/etc/pharma-agent/secrets/gcp-credentials.json
SPREADSHEET_ID=1YdwowSe3lofJOV7mx1M6grMJEmWTAJ0kW1GfS239NBM
